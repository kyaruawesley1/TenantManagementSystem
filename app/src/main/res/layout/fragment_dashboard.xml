<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="viewModel"
            type="com.example.tenantmanagementapp.ui.viewmodel.TenantViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">


        <TextView
            android:id="@+id/tenantCountTextView"
            android:text="@{viewModel.tenantCountText}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="16dp"
            android:background="#E8EEF7"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/overviewTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/totalRentTextView" />

        <TextView
            android:id="@+id/totalRentTextView"
            android:text="@{viewModel.totalRentText}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:gravity="center"
            android:padding="16dp"
            android:background="#E8EEF7"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/tenantCountTextView"
            app:layout_constraintStart_toEndOf="@id/tenantCountTextView"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ... existing buttons ... -->
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>